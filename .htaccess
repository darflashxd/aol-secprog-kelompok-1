Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application code and SQL files outside the web-accessible area.
    RewriteRule ^(?:app|database)(?:/|$) - [F,L,NC]

    # Let Apache serve files from public/ while keeping the repository root as DocumentRoot.
    RewriteRule ^$ public/index.php [L]
    # XAMPP's Apache Admin button commonly opens /dashboard.
    RewriteRule ^dashboard/?$ public/index.php [L]
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
